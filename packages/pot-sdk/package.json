{
  "name": "@pot/sdk",
  "license": "AGPL-3.0-only",
  "version": "0.1.0",
  "private": true,
  "description": "Typed client for the Pot hub, the Pot DAOs and the test USDC token: views, action builders, math. Source-only TypeScript (no build step).",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/types/api.ts",
    "./sign": "./src/sign/index.ts",
    "./testing": "./src/testing/index.ts",
    "./demo": "./src/demo/types.ts",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:node": "node --test \"src/**/*.node.test.ts\"",
    "test:testnet": "POT_SDK_TESTNET=1 vitest run src/read/testnet.integration.test.ts"
  },
  "peerDependencies": {
    "near-api-js": "7.3.1"
  },
  "peerDependenciesMeta": {
    "near-api-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "near-api-js": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
