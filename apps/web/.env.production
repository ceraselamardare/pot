# Pot: production build on NEAR TESTNET. Every value here is PUBLIC. No secrets.
# Next.js loads this file for `next build` / `next start`. Vercel dashboard env vars with the same name win.
# The secrets go in Vercel as Sensitive vars only. Their names are listed at the bottom. Fresh production values
# were generated into apps/web/.keys/production.secrets.env (gitignored); the relayer, treasury and DB values come from you.

# --- Network and chain (public, read by the browser) ---
NEXT_PUBLIC_NETWORK=testnet
# Without this the app silently runs on mock data (lib/client/config.ts defaults to "mock").
NEXT_PUBLIC_DATA_SOURCE=testnet
# TODO: replace with the real Vercel URL once the project exists.
NEXT_PUBLIC_APP_URL=https://<project>.vercel.app
NEXT_PUBLIC_HUB_ID=pots.potprev.testnet
NEXT_PUBLIC_USDC_ID=usdc.potprev.testnet
# Never rpc.testnet.near.org (deprecated, ~3 s slower, returns 429).
NEXT_PUBLIC_RPC_URLS=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org
NEXT_PUBLIC_TX_API=https://tx.test.fastnear.com
NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io

# --- Server-side chain config (public account ids, not keys) ---
RELAYER_ACCOUNT_ID=users.potprev.testnet
TREASURY_ACCOUNT_ID=treasury.potprev.testnet
MPC_SIGN_DEPOSIT_YOCTO=1
# Sponsor-health thresholds in NEAR (the code defaults). Keep the relayer funded above 5 NEAR.
RELAYER_FLOOR_NEAR=1
RELAYER_CRITICAL_NEAR=2
RELAYER_WARN_NEAR=5
# Rate limits: no QUOTA_* overrides here. Production uses the code's production quotas
# (.env.local raises them for local testing only).

# --- Feature flags ---
# Sign-in is NEAR Auth (Google/email) or a NEAR wallet (NEAR Connect) only. The test-account sign-in and the live
# testnet demo (server-held keys) were removed in Rev 9 (plan/decisions.md), with their flags.
# NEAR Auth (Google/email): off until Peersyst allows our Vercel origin.
# Then set both to true and fill in the client id below.
NEXT_PUBLIC_FLAG_NEAR_AUTH=false
FLAG_NEAR_AUTH=false
# NEXT_PUBLIC_NEAR_AUTH_CLIENT_ID=
# NEXT_PUBLIC_NEAR_AUTH_DOMAIN=login.testnet.fast-auth.com
# NEXT_PUBLIC_NEAR_AUTH_SIGNING_AUDIENCE=auth0.jwt.fast-auth.testnet
# /demo is a simulation with no transactions.
# Web push on (the public VAPID key is below; its private key is a Vercel secret).
FLAG_PUSH=true
# 1Click on testnet is always simulated (the server enforces it).
ONECLICK_MODE=simulated

# --- Web push (the public half only) ---
# Generated with the production secrets; it pairs with VAPID_PRIVATE_KEY in apps/web/.keys/production.secrets.env.
# It must pair with the VAPID_PRIVATE_KEY you set in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BLSlWD1YlQn4kmficHUWN8Zs14D_1fUqX2JMGEVHHYv72ccAxcEFc40kEu5hdvgNwy7Nh4zY_opKze22EqL7VTI
# TODO: a real contact address.
VAPID_SUBJECT=mailto:<team-email>

# --- Secrets: set these in Vercel as "Sensitive", never in this file ---
# DATABASE_URL, DATABASE_URL_UNPOOLED       (set automatically by the Neon integration)
# RELAYER_KEYS, TREASURY_KEYS               (testnet keys; use separate production relayer keys, see LAUNCH.md)
# APP_HMAC_SECRET, CRON_SECRET, VAPID_PRIVATE_KEY   (fresh values in .keys/production.secrets.env)
# Optional: FASTNEAR_API_KEY, ONECLICK_API_KEY, ALERT_WEBHOOK_URL, BOTID_BYPASS_SECRET
