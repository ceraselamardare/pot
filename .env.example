# Pot environment variables: NAMES ONLY, never real secrets.
# Sources: plan/architecture.md §4.6-4.7, plan/api-spec.md, plan/frontend-architecture.md §1.5, plan/accounts-and-deploy.md.
#
# Local dev: copy to apps/web/.env.local (Next reads env files from the app dir) and fill in what you need.
# Secrets (marked [secret]) live only in Vercel as Secret env vars, per environment, and are NEVER added to the
# Development environment (`vercel env pull` would copy them to a laptop). Agents only ever get the PREVIEW
# relayer keys (D-63, H-17). Never put mainnet keys anywhere near this file.
# Never use https://rpc.testnet.near.org (deprecated, 429s; D-32).

# ---------------------------------------------------------------------------
# Public config (inlined into the client bundle at build time)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_NETWORK=testnet
# Origin used for metadataBase/OG URLs; previews fall back to https://$VERCEL_URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Hub and test-token accounts: pots.<root>.testnet / usdc.<root>.testnet (preview uses the preview.<root> namespace, D-02)
NEXT_PUBLIC_HUB_ID=
NEXT_PUBLIC_USDC_ID=
# Comma-separated RPC failover list (FastNEAR first, dRPC second). The build fails if near.org is present.
NEXT_PUBLIC_RPC_URLS=https://rpc.testnet.fastnear.com,https://near-testnet.drpc.org
NEXT_PUBLIC_TX_API=https://tx.test.fastnear.com
NEXT_PUBLIC_EXPLORER=https://testnet.nearblocks.io
# NEAR Auth (D-20/D-22). The shared testnet client only accepts http://localhost:3000 callbacks.
NEXT_PUBLIC_NEAR_AUTH_CLIENT_ID=
NEXT_PUBLIC_NEAR_AUTH_DOMAIN=login.testnet.fast-auth.com
# Web Push public VAPID key (never rotate in prod; private half is VAPID_PRIVATE_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Mock-first build (implementation-plan §2): mock | testnet
NEXT_PUBLIC_DATA_SOURCE=mock
# Relay transport: mock (applies intents to MockChain) | live
NEXT_PUBLIC_RELAY_MODE=mock

# ---------------------------------------------------------------------------
# Feature flags: one env var each. Server reads FLAG_<NAME>, client reads NEXT_PUBLIC_FLAG_<NAME>.
# Values: true | false. (frontend-architecture §1.5, implementation-plan §1.5 cut order)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FLAG_NEAR_AUTH=false
NEXT_PUBLIC_FLAG_WALLET=true
NEXT_PUBLIC_FLAG_APPLE=false
NEXT_PUBLIC_FLAG_TELEGRAM=false
NEXT_PUBLIC_FLAG_EMAIL=false
NEXT_PUBLIC_FLAG_NUDGE=false
NEXT_PUBLIC_FLAG_PAIRING=false
NEXT_PUBLIC_FLAG_PUSH=false
NEXT_PUBLIC_FLAG_RULES_EDIT=false
NEXT_PUBLIC_FLAG_XC=false
NEXT_PUBLIC_FLAG_CLOSE=false
# Local Playwright builds only (e2e/integrations, e2e/testnet): NEAR Connect → the e2e mock wallet. next.config.ts
# refuses it on any Vercel build and on mainnet. Never set it anywhere else.
NEXT_PUBLIC_E2E_MOCK_WALLET=

FLAG_NEAR_AUTH=false
FLAG_WALLET=true
FLAG_APPLE=false
FLAG_TELEGRAM=false
FLAG_EMAIL=false
FLAG_NUDGE=false
FLAG_PAIRING=false
FLAG_PUSH=false
FLAG_RULES_EDIT=false
FLAG_XC=false
FLAG_CLOSE=false

# ---------------------------------------------------------------------------
# Server config (non-secret)
# ---------------------------------------------------------------------------
# Must equal the azp of NEAR Auth tokens; production accepts only a Pot-dedicated client id (api-spec §4, M-1)
NEAR_AUTH_CLIENT_ID=
# users.<root>.testnet (prod) / users.preview.<root>.testnet (preview): relayer + parent of user accounts
RELAYER_ACCOUNT_ID=
# treasury.<root>.testnet: hot faucet / 1Click simulator account
TREASURY_ACCOUNT_ID=
# NEAR Auth MPC sign deposit, in yocto; 1 yocto is proven on chain (D-21 Rev 4)
MPC_SIGN_DEPOSIT_YOCTO=1
# 1Click: simulated on testnet; real only in the mainnet clip build
ONECLICK_MODE=simulated
# mailto: or https: contact for VAPID
VAPID_SUBJECT=
# Fallback alert destination when ALERT_WEBHOOK_URL is unset (needs Resend, i.e. a domain; H-07 = none yet)
ALERT_EMAIL=
# Daily caps are env-overridable as QUOTA_* (api-spec §3.5); leave unset to use the coded defaults.
# VERCEL_ENV / VERCEL_URL are injected by Vercel; locally VERCEL_ENV is unset (treated as development).

# ---------------------------------------------------------------------------
# Database (Neon in Vercel; local Postgres 17 from infra/docker-compose.yml via `pnpm db:up`)
# ---------------------------------------------------------------------------
# Runtime (pooled) connection
DATABASE_URL=postgres://pot:pot@localhost:54329/pot
# Migrations only (drizzle-kit migrate, CI) - never from a Vercel build
DATABASE_URL_UNPOOLED=postgres://pot:pot@localhost:54329/pot
# API tests (Vitest) run against a separate database in the same container
DATABASE_URL_TEST=postgres://pot:pot@localhost:54329/pot_test

# ---------------------------------------------------------------------------
# Secrets [secret]: Vercel Secret env vars only (prod + preview, different values). Leave empty locally
# unless you were given the PREVIEW relayer keys.
# ---------------------------------------------------------------------------
# [secret] comma-separated ed25519 secret keys, full-access on RELAYER_ACCOUNT_ID (8 prod, 4 preview)
RELAYER_KEYS=
# [secret] full-access keys on TREASURY_ACCOUNT_ID (3)
TREASURY_KEYS=
# [secret] >= 32 chars: IP-hash salt, session challenge MAC, pairing ids
APP_HMAC_SECRET=
# [secret] Bearer token for the Vercel cron (prod)
CRON_SECRET=
# [secret] Web Push signing key (per environment)
VAPID_PRIVATE_KEY=
# [secret] email (only after a domain exists, H-07)
RESEND_API_KEY=
# [secret] Telegram (Phase 2, first to cut)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_INFO=
# [secret] optional 1Click partner key (H-08)
ONECLICK_API_KEY=
# [secret] optional FastNEAR key for server-side RPC from shared Vercel egress IPs (H-16)
FASTNEAR_API_KEY=
# [secret] BotID bypass for Playwright on previews (separate prod value for the nightly job)
BOTID_BYPASS_SECRET=
# [secret] Discord/Slack incoming webhook for team alerts
ALERT_WEBHOOK_URL=
# [secret] GitHub Actions only (e2e against protected previews); never in Vercel
VERCEL_AUTOMATION_BYPASS_SECRET=

# --- backend wave 1 additions (see notes/backend.md) ---
# Server-side overrides of the public ids / RPC list
HUB_ID=
USDC_ID=
# Server RPC failover list (comma-separated); rpc.testnet.near.org is refused at boot
SERVER_RPC_URLS=
# Test-only relay rules "receiver:method:depositYocto[:maxTgas]"; ignored on production and mainnet
RELAY_TEST_ALLOWLIST=
# Sponsor-health thresholds in NEAR (api-spec §3.5)
RELAYER_FLOOR_NEAR=1
RELAYER_CRITICAL_NEAR=2
RELAYER_WARN_NEAR=5
# Token registration deposit (yocto)
TOKEN_STORAGE_DEPOSIT_YOCTO=1250000000000000000000
# NEAR Auth: JWKS override; require the challenge nonce (always true on production)
NEAR_AUTH_JWKS_URL=
NEAR_AUTH_REQUIRE_NONCE=false
# MPC contracts for derived_public_key
MPC_CONTRACT_ID=v1.signer-prod.testnet
FAST_AUTH_CONTRACT_ID=fast-auth.testnet
# Turn on checkBotId() (needs withBotId + client init)
FLAG_BOTID=false
# 1 runs server/live/*.live.test.ts against testnet (under scripts/with-testnet-lock.sh)
LIVE_TESTNET=
# Testnet e2e/live accounts (e2e/testnet/accounts.ts): the holding account that funds each run's throwaway
# accounts through near-cli-rs (legacy keychain), and what each run parent gets (returned at the end)
E2E_FUNDS_ACCOUNT=pot-funds-65k8.testnet
# optional override; default 0.004 + 0.0085 per person
E2E_PARENT_NEAR=
# "Snap the receipt" (Spend sheet; server/features/receipts). SERVER ONLY: never a NEXT_PUBLIC_ name. With a key the
# option shows (GET /api/health features.receipts); without one it's hidden. Key: NEAR AI Cloud (cloud.near.ai);
# on Vercel add it as a Sensitive env var. The photo is read in memory and never stored (D-61).
NEAR_AI_API_KEY=
# defaults: https://cloud-api.near.ai/v1 and z-ai/glm-5.3-flash (NEAR-hosted, vision, structured output, attested TEE; ~6 s per receipt)
NEAR_AI_BASE_URL=
NEAR_AI_RECEIPT_MODEL=
# provider timeout in ms (default 25000; the client falls back to typing at 30 s)
NEAR_AI_RECEIPT_TIMEOUT_MS=
# "mock" = the deterministic sample reading without a key (local/preview only, refused on production); "off" = hidden
NEAR_AI_RECEIPTS_MODE=
# 1 (with NEAR_AI_API_KEY) runs server/features/receipts/nearai.live.test.ts: one paid read of the fixture photo
LIVE_NEARAI=
# A receipt in another currency is converted to dollars at a live reference rate (server/features/fx.ts: Frankfurter /
# ECB first, open.er-api.com as the fallback; free, no key, cached 1 h, 3 s timeout). "off" = never convert (the sheet
# asks for dollars); "mock" = the fixed sample rates (refused on production); unset = mock with the mock reader, else live
POT_FX_MODE=
# 1 runs server/features/fx.live.test.ts against the real rate sources (free, no key)
LIVE_FX=
