{
  "name": "pot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.0",
  "engines": {
    "node": ">=22.22.2",
    "pnpm": ">=11.1.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm -r --filter './packages/*' --if-present build && pnpm --filter web build",
    "start": "pnpm --filter web start",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "pnpm -r lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:contracts": "cd contracts && cargo test",
    "gen:demo": "scripts/run gen-demo-script",
    "check:demo": "scripts/run gen-demo-script --check",
    "check:demo-real": "scripts/run check-demo-real",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:psql": "docker exec -it pot-postgres psql -U pot -d pot"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
